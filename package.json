{
  "name": "token-panic",
  "version": "0.1.0",
  "description": "一个快速查看多个 LLM 服务用量、余额和限额状态的小面板",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev:main": "tsc -p tsconfig.main.json",
    "dev:renderer": "vite dev",
    "dev:electron": "ELECTRON_RUN_AS_NODE= electron .",
    "dev": "npm run dev:main && concurrently -k \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"vite dev\" \"sleep 2 && ELECTRON_RUN_AS_NODE= electron .\"",
    "build:main": "rm -rf dist/main && tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac && scripts/apply-dmg-icon.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
